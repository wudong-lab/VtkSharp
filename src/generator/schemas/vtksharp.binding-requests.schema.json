{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VtkSharp Binding Requests",
  "type": "object",
  "additionalProperties": false,
  "required": ["requests"],
  "properties": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": { "enum": ["manual", "vtk-example"] },
        "name": { "type": "string" },
        "original": { "type": "string" }
      }
    },
    "requests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["class"],
        "properties": {
          "class": { "type": "string", "minLength": 1 },
          "classOnly": { "type": "boolean" },
          "allOverloads": { "type": "boolean" },
          "methods": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "signatures": { "type": "array", "items": { "type": "string", "minLength": 1 } }
        },
        "oneOf": [
          {
            "required": ["classOnly"],
            "properties": { "classOnly": { "const": true }, "methods": { "maxItems": 0 }, "signatures": { "maxItems": 0 } }
          },
          {
            "properties": { "classOnly": { "const": false } },
            "anyOf": [
              { "required": ["methods"], "properties": { "methods": { "minItems": 1 } } },
              { "required": ["signatures"], "properties": { "signatures": { "minItems": 1 } } }
            ]
          }
        ]
      }
    }
  }
}
