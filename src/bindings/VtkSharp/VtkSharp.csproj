<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>1701;1702;CS0109;CS1591</NoWarn>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <RootNamespace>VtkSharp</RootNamespace>

    <!-- NuGet package identity -->
    <PackageId>VtkSharp</PackageId>
    <Title>VtkSharp — VTK .NET Bindings</Title>
    <Description>
      VtkSharp is an unofficial open-source .NET binding for VTK (Visualization Toolkit).
      Uses a C ABI shim and C# P/Invoke approach. 
    </Description>
    <PackageTags>VTK;visualization;graphics;rendering;netstandard;windows;x64</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Memory" Version="4.5.5" Condition="'$(TargetFramework)' == 'netstandard2.0'" />
  </ItemGroup>

  <!-- Dynamic VTK modules and dependencies deploy together under the shared runtime directory. -->
  <PropertyGroup>
    <VtkSharpNativeLinkage Condition="'$(VtkSharpNativeLinkage)' == ''">Dynamic</VtkSharpNativeLinkage>
    <VtkSharpNativeRuntimeDirectory Condition="'$(VtkSharpNativeRuntimeDirectory)' == ''"></VtkSharpNativeRuntimeDirectory>
    <VtkSharpNativeDllName>VtkSharp.Native.CommonCore.dll</VtkSharpNativeDllName>
    <VtkSharpNativeBuildRoot>$(MSBuildThisFileDirectory)..\VtkSharp.Native\out\build</VtkSharpNativeBuildRoot>
    <VtkSharpNativeDefaultDllPath Condition="'$(VtkSharpNativeLinkage)' == 'Static'">$(VtkSharpNativeBuildRoot)\win-x64-vs2026\$(Configuration)\$(VtkSharpNativeDllName)</VtkSharpNativeDefaultDllPath>
    <VtkSharpNativeVs2022DllPath Condition="'$(VtkSharpNativeLinkage)' == 'Static'">$(VtkSharpNativeBuildRoot)\win-x64-vs2022\$(Configuration)\$(VtkSharpNativeDllName)</VtkSharpNativeVs2022DllPath>
    <VtkSharpNativeDefaultDllPath Condition="'$(VtkSharpNativeLinkage)' == 'Dynamic'">$(VtkSharpNativeBuildRoot)\dynamic\win-x64-vs2026\$(Configuration)\$(VtkSharpNativeDllName)</VtkSharpNativeDefaultDllPath>
    <VtkSharpNativeVs2022DllPath Condition="'$(VtkSharpNativeLinkage)' == 'Dynamic'">$(VtkSharpNativeBuildRoot)\dynamic\win-x64-vs2022\$(Configuration)\$(VtkSharpNativeDllName)</VtkSharpNativeVs2022DllPath>
    <VtkSharpNativeDllPath Condition="Exists('$(VtkSharpNativeDefaultDllPath)')">$(VtkSharpNativeDefaultDllPath)</VtkSharpNativeDllPath>
    <VtkSharpNativeDllPath Condition="'$(VtkSharpNativeDllPath)' == '' And Exists('$(VtkSharpNativeVs2022DllPath)')">$(VtkSharpNativeVs2022DllPath)</VtkSharpNativeDllPath>
    <VtkSharpNativeOutputDirectory Condition="'$(VtkSharpNativeDllPath)' != ''">$([System.IO.Path]::GetDirectoryName('$(VtkSharpNativeDllPath)'))</VtkSharpNativeOutputDirectory>
  </PropertyGroup>

  <PropertyGroup>
    <VtkSharpNativeRuntimeSourceDirectory Condition="'$(VtkSharpNativeRuntimeDirectory)' != ''">$(VtkSharpNativeRuntimeDirectory)</VtkSharpNativeRuntimeSourceDirectory>
    <VtkSharpNativeRuntimeSourceDirectory Condition="'$(VtkSharpNativeRuntimeSourceDirectory)' == '' And Exists('$(VtkSharpNativeDllPath)')">$(VtkSharpNativeOutputDirectory)</VtkSharpNativeRuntimeSourceDirectory>
    <VtkSharpNativeManifestPath Condition="Exists('$(VtkSharpNativeRuntimeSourceDirectory)\VtkSharp.native-dependencies.json')">$(VtkSharpNativeRuntimeSourceDirectory)\VtkSharp.native-dependencies.json</VtkSharpNativeManifestPath>
    <VtkSharpNativeManifestPath Condition="'$(VtkSharpNativeManifestPath)' == '' And Exists('$(VtkSharpNativeRuntimeSourceDirectory)\native-dependencies.json')">$(VtkSharpNativeRuntimeSourceDirectory)\native-dependencies.json</VtkSharpNativeManifestPath>
  </PropertyGroup>

  <ItemGroup Condition="Exists('$(VtkSharpNativeDllPath)') Or '$(VtkSharpNativeRuntimeDirectory)' != ''">
    <Content Include="$(VtkSharpNativeRuntimeSourceDirectory)\*.dll"
             Pack="true"
             PackagePath="native/VtkSharp/win-x64/"
             Link="native\VtkSharp\win-x64\%(Filename)%(Extension)"
             TargetPath="native\VtkSharp\win-x64\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(VtkSharpNativeManifestPath)"
             Condition="Exists('$(VtkSharpNativeManifestPath)')"
             Pack="true"
             PackagePath="native/VtkSharp/win-x64/VtkSharp.native-dependencies.json"
             Link="native\VtkSharp\win-x64\VtkSharp.native-dependencies.json"
             TargetPath="native\VtkSharp\win-x64\VtkSharp.native-dependencies.json"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup Condition="'$(VtkSharpNativeRuntimeDirectory)' != ''">
    <None Include="$(VtkSharpNativeRuntimeDirectory)\licenses\**\*"
          Pack="true"
          PackagePath="licenses/VTK/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <Target Name="ValidateNativePackageAsset" BeforeTargets="GenerateNuspec">
    <Error Condition="!Exists('$(VtkSharpNativeDllPath)')"
           Text="VtkSharp.Native.CommonCore.dll is required for packaging. Build native with the matching Configuration or run tools/package-nuget.ps1." />
    <Error Condition="'$(VtkSharpNativeRuntimeDirectory)' != '' And !Exists('$(VtkSharpNativeRuntimeDirectory)\licenses\VTK-Copyright.txt')"
           Text="VTK and third-party license notices are required in the native runtime staging directory." />
  </Target>

  <!-- Package README -->
  <ItemGroup>
    <None Include="buildTransitive\VtkSharp.targets" Pack="true" PackagePath="buildTransitive/VtkSharp.targets" />
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="VTK-LICENSE.txt" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
