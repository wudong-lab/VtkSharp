<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>1701;1702;CS0109;CS1591</NoWarn>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <RootNamespace>VtkSharp</RootNamespace>

    <!-- NuGet package identity -->
    <PackageId>VtkSharp</PackageId>
    <Title>VtkSharp — VTK .NET Bindings</Title>
    <Description>
      VtkSharp is an unofficial open-source .NET binding for VTK (Visualization Toolkit).
      Uses a C ABI shim and C# P/Invoke approach. 
    </Description>
    <PackageTags>VTK;visualization;graphics;rendering;netstandard;windows;x64</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Memory" Version="4.5.5" Condition="'$(TargetFramework)' == 'netstandard2.0'" />
  </ItemGroup>

  <!--
    Native DLL resolution for local development builds.
    Tries VS2026 output first, falls back to VS2022.
    The selected DLL is copied to the output directory and packed once as a win-x64 native asset.
  -->
  <PropertyGroup>
    <VtkSharpNativeDllName>VtkSharp.Native.dll</VtkSharpNativeDllName>
    <VtkSharpNativeDefaultDllPath>$(MSBuildThisFileDirectory)..\VtkSharp.Native\out\build\win-x64-vs2026\$(Configuration)\$(VtkSharpNativeDllName)</VtkSharpNativeDefaultDllPath>
    <VtkSharpNativeVs2022DllPath>$(MSBuildThisFileDirectory)..\VtkSharp.Native\out\build\win-x64-vs2022\$(Configuration)\$(VtkSharpNativeDllName)</VtkSharpNativeVs2022DllPath>
    <VtkSharpNativeDllPath Condition="Exists('$(VtkSharpNativeDefaultDllPath)')">$(VtkSharpNativeDefaultDllPath)</VtkSharpNativeDllPath>
    <VtkSharpNativeDllPath Condition="'$(VtkSharpNativeDllPath)' == '' And Exists('$(VtkSharpNativeVs2022DllPath)')">$(VtkSharpNativeVs2022DllPath)</VtkSharpNativeDllPath>
  </PropertyGroup>

  <ItemGroup Condition="Exists('$(VtkSharpNativeDllPath)')">
    <Content Include="$(VtkSharpNativeDllPath)" 
             Pack="true"
             PackagePath="runtimes/win-x64/native/VtkSharp.Native.dll"
             Link="native\$(VtkSharpNativeDllName)" 
             TargetPath="$(VtkSharpNativeDllName)" 
             CopyToOutputDirectory="PreserveNewest" 
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="ValidateNativePackageAsset" BeforeTargets="GenerateNuspec">
    <Error Condition="!Exists('$(VtkSharpNativeDllPath)')"
           Text="VtkSharp.Native.dll is required for packaging. Build native with the matching Configuration or run tools/package-nuget.ps1." />
  </Target>

  <!-- Package README -->
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="VTK-LICENSE.txt" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
